# ---------------------------------------------------------------------------
# Big Data IoT demo stack — copy to `.env` and adjust before first run:
#     cp .env.example .env
# Everything below is read by implementation/compose.yaml (compose variable
# interpolation) and forwarded to containers where relevant.
# Real secrets must never be committed; `.env` is git-ignored.
# ---------------------------------------------------------------------------

# ----- Host data root (bind-mounted into containers at /data/bigdata) -----
# Default assumes a dedicated path on the target machine. On a machine without
# permission to create /data, use a local fallback instead, e.g.:
#     DATA_ROOT=/home/<user>/bigdata-demo
# scripts/prepare-host.sh creates the required subdirectories:
#   {bronze,silver,quarantine,checkpoints,logs,control} under DATA_ROOT.
DATA_ROOT=/data/bigdata

# ----- Host ports (change when another project occupies a port) -----------
# NOTE: on the dev host 2026-09-14, TCP 1883 is used by another project
# (mobile_backend-mosquitto-1). Prefer MQTT_HOST_PORT=1884 there.
MQTT_HOST_PORT=1883
KAFKA_HOST_PORT=9092
BACKEND_HOST_PORT=8000
DASHBOARD_HOST_PORT=8088
POSTGRES_HOST_PORT=5432

# ----- PostgreSQL (one instance, two databases: app + airflow_meta) -------
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=bigdata-demo-change-me
APP_DB=app
AIRFLOW_DB=airflow_meta

# ----- Airflow -------------------------------------------------------------
# UID for bind-mounted log directories ownership (airflow runs as this UID)
AIRFLOW_UID=50000

# ----- Pipeline tuning -----------------------------------------------------
KAFKA_TOPIC=sensor_raw

# simulator
SIM_RATE=5          # events per second
SIM_SENSORS=20      # number of sensor ids (TEMP_01..TEMP_NN)
SIM_SPIKE_PCT=2     # % of events with temperature 35.5..42 C (triggers alerts)
FAULT_INJECT=0      # 1 = inject duplicates/missing fields/out-of-bounds/bad timestamps

# validation / business rules (mirrored by Spark jobs and unit tests)
BOUNDS_MIN=-50      # physical lower bound for temperature_c (quarantine outside)
BOUNDS_MAX=200      # physical upper bound for temperature_c (quarantine outside)
ALERT_THRESHOLD_C=35  # valid events above this create an alert (still Silver)
LATE_THRESHOLD_S=60   # informational is_late flag threshold, seconds

# ----- One-shot batch window (used by scripts/run-mode.sh batch) -----------
# UTC ISO-8601, both bounds must sit on hour boundaries, [start,end) with at
# least one full hour, e.g.:
# BATCH_START=2026-09-15T01:00:00Z
# BATCH_END=2026-09-15T02:00:00Z
