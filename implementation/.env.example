# ---------------------------------------------------------------------------
# Big Data IoT demo stack — copy to `.env` and adjust before first run:
#     cp .env.example .env
# Everything below is read by implementation/compose.yaml (compose variable
# interpolation) and forwarded to containers where relevant.
# Real secrets must never be committed; `.env` is git-ignored.
# ---------------------------------------------------------------------------

# ----- Host data root (bind-mounted into containers at /data/bigdata) -----
# Default assumes a dedicated path on the target machine. On a machine without
# permission to create /data, use a local fallback instead, e.g.:
#     DATA_ROOT=/home/<user>/bigdata-demo
# scripts/prepare-host.sh creates the required subdirectories:
#   {bronze,silver,quarantine,checkpoints,logs,control} under DATA_ROOT.
DATA_ROOT=/data/bigdata

# ----- Host ports (change when another project occupies a port) -----------
# NOTE: on the dev host 2026-09-14, TCP 1883 is used by another project
# (mobile_backend-mosquitto-1). Prefer MQTT_HOST_PORT=1884 there.
MQTT_HOST_PORT=1883
KAFKA_HOST_PORT=9092
BACKEND_HOST_PORT=8000
DASHBOARD_HOST_PORT=8088
POSTGRES_HOST_PORT=5432

# ----- PostgreSQL (one instance, one database) -----------------------------
POSTGRES_USER=bigdata
POSTGRES_PASSWORD=bigdata-demo-change-me
APP_DB=app

# ----- Pipeline tuning -----------------------------------------------------
KAFKA_TOPIC=sensor_raw

# simulator (default compose run = single sim01 source; scripts/run-multi-sim.sh
# spawns 5 zones zoneA..zoneE, so the demo total is 5 x 5 sensors x 2 evt/s = 50 evt/s)
SIM_RATE=2          # events per second per simulator container
SIM_SENSORS=5       # sensor ids per zone ({prefix}_{TYPE}_{NNN}, types cycle WEATHER/AIR/MULTI)
SIM_PREFIX=sim01    # sensor/event prefix of the single template-simulator run (run-mode.sh live uses zoneA..zoneE instead)
SIM_SPIKE_PCT=2     # % of events with one alert-crossing metric reading
FAULT_INJECT=0      # 1 = inject duplicates/missing fields/non-numeric/out-of-bounds/bad timestamps

# validation / business rules (mirrored by Spark jobs and unit tests)
# The six metric bounds + alert thresholds/directions are the module-level
# METRIC_CONFIG table in spark/jobs/common.py (single source of truth for
# validation, Q3 alerts and the Gold metric dimension).
LATE_THRESHOLD_S=60   # informational is_late flag threshold, seconds

# ----- One-shot batch window (used by scripts/run-mode.sh batch) -----------
# UTC ISO-8601, both bounds must sit on hour boundaries, [start,end) with at
# least one full hour, e.g.:
# BATCH_START=2026-09-15T01:00:00Z
# BATCH_END=2026-09-15T02:00:00Z

# ----- Hourly batch (scripts/run-batch-hourly.sh, host cron) ----------------
# BATCH_GRACE_S: seconds to wait before reading Silver so events published
# near the hour boundary can land first (0 disables). rerun is safe anyway
# (full-replace upsert).
BATCH_GRACE_S=120

# ----- Spark benchmark tuning (baseline defaults preserve current behavior) ----
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=2
# stream_app.py reads STREAM_TRIGGER; keep it explicit so tuning is effective.
STREAM_TRIGGER="5 seconds"
MAX_OFFSETS_PER_TRIGGER=20000
MAX_FILES_PER_TRIGGER=1000
MAX_FILES_PER_TRIGGER_Q3=500
JDBC_BATCH_SIZE=1000
# Orchestration waits; these do not change throughput caps.
DRAIN_WAIT_S=600
DOWNSTREAM_SETTLE_S=30
BENCHMARK_RUN_ID=
MANIFEST_FILE=
DELIVERY_LOG=
