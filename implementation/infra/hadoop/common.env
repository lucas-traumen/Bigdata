CORE-SITE.XML_fs.defaultFS=hdfs://hdfs-namenode:9000
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.namenode.rpc-address=hdfs-namenode:9000
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.namenode.name.dir=file:///opt/hadoop/data/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///opt/hadoop/data/dfs
# Heap budget matches container mem_limit in docker-compose.yml
# (namenode 1536m / datanodes 896m -> 640m heap keeps headroom for off-heap).
HADOOP_HEAPSIZE_MAX=640m
