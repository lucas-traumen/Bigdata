\def\coverpage{
\pagestyle{empty}

% Lề chữ cân bằng đều 25mm 4 góc (Trùng tâm với khung viền)
\newgeometry{left=25mm, right=25mm, top=25mm, bottom=25mm}

%% trang bìa
\begin{smashminipage}
\begin{tikzpicture}[remember picture, overlay]
% Viền ngoài đều 15mm 4 góc (Trùng tâm với chữ)
\draw [line width=0.9pt]
     ($ (current page.north west) + (15mm,-15mm) $)
     rectangle
     ($ (current page.south east) + (-15mm,15mm) $);
% Viền trong đều 17.5mm 4 góc
\draw [line width=1.5pt]
     ($ (current page.north west) + (17.5mm,-17.5mm) $)
     rectangle
     ($ (current page.south east) + (-17.5mm,17.5mm) $);
\end{tikzpicture}

\@makecoverbody
\end{smashminipage}

%% trang bìa lót (nếu có)
\begin{smashminipage}
\@makecoverbody
\end{smashminipage}

% Trả lại lề chuẩn (trái 30mm, phải 20mm) để đóng gáy
\restoregeometry
}

